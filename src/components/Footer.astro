---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />

	<div class="portal-footer sl-flex">
		<p>© 2026 TIScriptBE Portal — Portal dokumentasi script automasi &amp; bot.</p>
		<p>
			<a href="https://github.com/rsvmusabb/dhoells-wabot">Neural WA Bot di GitHub</a>
		</p>
	</div>

	{
		config.credits && (
			<a class="kudos sl-flex" href="https://starlight.astro.build">
				Built with Starlight
			</a>
		)
	}
</footer>

<style>
	@layer starlight.core {
		footer {
			flex-direction: column;
			gap: 1.5rem;
		}
		.meta {
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 3rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}

		.portal-footer {
			flex-direction: column;
			gap: 0.25rem;
			padding-top: 1.5rem;
			border-top: 1px solid var(--sl-color-gray-5);
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.portal-footer p {
			margin: 0;
		}
		.portal-footer a {
			color: var(--sl-color-accent-high);
			text-decoration: none;
		}
		.portal-footer a:hover {
			text-decoration: underline;
		}

		.kudos {
			align-items: center;
			gap: 0.5em;
			margin: 1.5rem auto;
			font-size: var(--sl-text-xs);
			text-decoration: none;
			color: var(--sl-color-gray-3);
		}
		.kudos:hover {
			color: var(--sl-color-white);
		}
	}
</style>
